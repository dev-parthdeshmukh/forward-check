# Copy this file to .env and fill in the keys. .env is git-ignored; never commit it.

# Google AI Studio key (https://aistudio.google.com/apikey). Used to transcribe voice notes and as the fallback model.
GEMINI_API_KEY=

# Google Cloud key with the "Fact Check Tools API" enabled. Used to look up published fact-checks.
FACTCHECK_API_KEY=

# Token from @BotFather. Only needed for the Telegram bot.
TELEGRAM_BOT_TOKEN=

# Optional settings; the defaults are shown.
# LLM_BACKEND=claude_cli
# LLM_FALLBACK=gemini
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_CLI_PATH=
# GEMINI_MODEL=gemini-3.1-flash-lite
# JUDGE_EFFORT=low
# CACHE_TTL_DAYS=7
